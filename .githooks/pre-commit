#!/usr/bin/env bash
# Regenerate build.yaml when scripts/firmware.py is committed, and re-render
# the keymap drawing when the keymap or the drawer config is committed; add
# the results to the same commit. Enable once per clone:
#   git config core.hooksPath .githooks
# Renders from the working tree: stage the whole keymap file, not parts of it.
set -euo pipefail
if git diff --cached --name-only | grep -qxE 'scripts/firmware\.py|build\.yaml'; then
    python3 scripts/firmware.py gen
    git add build.yaml
fi
if git diff --cached --name-only |
    grep -qxE 'config/corne\.keymap|img/keymap-img/keymap_drawer\.config\.yaml'; then
    scripts/draw-keymap.sh
    git add img/keymap-img/corne.yaml img/keymap-img/corne.svg
fi
