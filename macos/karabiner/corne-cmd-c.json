{
  "title": "Corne: Cmd+C = Ctrl+C everywhere, Cmd+Shift+C = copy",
  "rules": [
    {
      "description": "Corne: Cmd+C = Ctrl+C (interrupt in terminals) in every app, Cmd+Shift+C = copy",
      "manipulators": [
        { "type": "basic",
          "from": { "key_code": "c", "modifiers": { "mandatory": ["command", "shift"] } },
          "to": [{ "key_code": "c", "modifiers": ["left_command"] }],
          "conditions": [
            { "type": "device_if", "identifiers": [{ "vendor_id": 7504, "product_id": 24926 }] }
          ] },
        { "type": "basic",
          "from": { "key_code": "c", "modifiers": { "mandatory": ["command"] } },
          "to": [{ "key_code": "c", "modifiers": ["left_control"] }],
          "conditions": [
            { "type": "device_if", "identifiers": [{ "vendor_id": 7504, "product_id": 24926 }] }
          ] }
      ]
    }
  ]
}
