{
  "title": "Corne: Terminal.app, Cmd+A E U K R L = readline",
  "rules": [
    {
      "description": "Corne: Terminal.app, Cmd+A = Ctrl+A (line start, as in Linux terminals)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "a",
            "modifiers": {
              "mandatory": [
                "command"
              ]
            }
          },
          "to": [
            {
              "key_code": "a",
              "modifiers": [
                "left_control"
              ]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.apple\\.Terminal$"
              ]
            },
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 7504,
                  "product_id": 24926
                }
              ]
            }
          ]
        }
      ]
    },
    {
