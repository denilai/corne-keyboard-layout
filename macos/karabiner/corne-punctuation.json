{
  "title": "Corne: punctuation independent of the input source",
  "rules": [
    {
      "description": "Corne: KP_1 KP_2 KP_3 = , . ? in any input source",
      "manipulators": [
        { "type": "basic",
          "from": { "key_code": "keypad_1", "modifiers": { "optional": ["caps_lock"] } },
          "to": [{ "key_code": "slash", "modifiers": ["left_shift"] }],
          "conditions": [
            { "type": "device_if", "identifiers": [{ "vendor_id": 7504, "product_id": 24926 }] },
            { "type": "input_source_if", "input_sources": [{ "input_source_id": "^com\\.apple\\.keylayout\\.RussianWin$" }] }
          ] },
        { "type": "basic",
          "from": { "key_code": "keypad_2", "modifiers": { "optional": ["caps_lock"] } },
          "to": [{ "key_code": "slash" }],
          "conditions": [
            { "type": "device_if", "identifiers": [{ "vendor_id": 7504, "product_id": 24926 }] },
            { "type": "input_source_if", "input_sources": [{ "input_source_id": "^com\\.apple\\.keylayout\\.RussianWin$" }] }
          ] },
        { "type": "basic",
          "from": { "key_code": "keypad_3", "modifiers": { "optional": ["caps_lock"] } },
          "to": [{ "key_code": "7", "modifiers": ["left_shift"] }],
          "conditions": [
            { "type": "device_if", "identifiers": [{ "vendor_id": 7504, "product_id": 24926 }] },
            { "type": "input_source_if", "input_sources": [{ "input_source_id": "^com\\.apple\\.keylayout\\.RussianWin$" }] }
          ] },

        { "type": "basic",
          "from": { "key_code": "keypad_1", "modifiers": { "optional": ["caps_lock"] } },
          "to": [{ "key_code": "comma" }],
          "conditions": [
            { "type": "device_if", "identifiers": [{ "vendor_id": 7504, "product_id": 24926 }] }
          ] },
        { "type": "basic",
          "from": { "key_code": "keypad_2", "modifiers": { "optional": ["caps_lock"] } },
          "to": [{ "key_code": "period" }],
          "conditions": [
            { "type": "device_if", "identifiers": [{ "vendor_id": 7504, "product_id": 24926 }] }
          ] },
        { "type": "basic",
          "from": { "key_code": "keypad_3", "modifiers": { "optional": ["caps_lock"] } },
          "to": [{ "key_code": "slash", "modifiers": ["left_shift"] }],
          "conditions": [
            { "type": "device_if", "identifiers": [{ "vendor_id": 7504, "product_id": 24926 }] }
          ] }
      ]
    }
  ]
}
